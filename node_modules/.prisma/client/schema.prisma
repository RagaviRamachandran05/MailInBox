generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders          Sender[]
  campaigns        EmailCampaign[]
  emails           Email[]
  slackConnections SlackConnection[]

  @@map("users")
}

model Sender {
  id               String   @id @default(uuid())
  userId           String
  name             String
  email            String
  etherealUser     String?
  etherealPassword String?
  hourlyLimit      Int      @default(200)
  isDefault        Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails    Email[]
  campaigns EmailCampaign[]

  @@index([userId])
  @@map("senders")
}

model EmailCampaign {
  id                 String   @id @default(uuid())
  userId             String
  senderId           String?
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int      @default(2000)
  hourlyLimit        Int      @default(100)
  totalEmails        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  emails Email[]

  @@index([userId])
  @@index([createdAt])
  @@map("email_campaigns")
}

model Email {
  id           String    @id @default(uuid())
  campaignId   String
  userId       String
  senderId     String?
  recipient    String
  subject      String
  body         String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String    @default("scheduled")
  attempts     Int       @default(0)
  bullJobId    String?
  messageId    String?
  previewUrl   String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender?       @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
  @@index([campaignId])
  @@index([senderId])
  @@index([createdAt])
  @@map("emails")
}

model SlackConnection {
  id                 String   @id @default(uuid())
  userId             String
  teamId             String
  teamName           String
  incomingWebhookUrl String?
  accessToken        String
  connected          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("slack_connections")
}
