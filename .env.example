# ==========================================
# REACHINBOX FULL-STACK EMAIL SCHEDULER ENV
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=super_secure_jwt_session_secret_reachinbox_2026_x991

# Database (MySQL 8.0)
DATABASE_URL=mysql://scheduler_user:scheduler_password@localhost:3306/email_scheduler

# Redis (BullMQ & Distributed Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (Full-Text Search Engine)
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth (Real OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth & Notifications (Real Slack Integration)
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Ethereal Email SMTP (Auto-generated if left empty)
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker & Queue Execution Parameters
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
